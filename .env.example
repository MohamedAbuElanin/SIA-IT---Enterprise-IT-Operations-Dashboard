# Firebase Web App Configuration Template
# Copy this file to .env.local (or .env) and replace with your real Firebase Project values.
# Obtain these keys from Firebase Console -> Project Settings -> General -> Your apps -> Web app (</>)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=sia-it-1.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=sia-it-1
VITE_FIREBASE_STORAGE_BUCKET=sia-it-1.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Configurable Firebase email identity used internally for the "admin" user
VITE_ADMIN_EMAIL=admin@sia-it.local
